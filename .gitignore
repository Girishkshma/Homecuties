# ===========================
# Runtime / Uploaded Content
# ===========================

# Product images are uploaded at runtime by the API (AdminController.UploadProductImage)
# and served from wwwroot. Keep the folder via .gitkeep, but not the uploaded files.
HC.Services/HC.Services/wwwroot/images/products/*
!HC.Services/HC.Services/wwwroot/images/products/.gitkeep

