<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / Plesk configuration for the Homecuties admin (HC.Web.Admin), deployed at admin.homecuties.com.

  Deployment: publish the Angular build output (HC.Web.Admin/dist/hc.web.admin/browser) to the site
  root and keep this file next to index.html. This file lives in HC.Web.Admin/public, and
  angular.json copies everything from that folder into the build output, so it is deployed with
  every build automatically.

  Notes
  - Unlike HC.Web (storefront), this app is not built with SSR, so the build emits a plain
    index.html. The fallback rule below is only a safety net in case SSR is ever enabled, because
    SSR builds emit the shell as index.csr.html.
  - The admin API is hosted on another origin (https://serv.homecuties.com/api/admin), so no proxy
    entry is needed here; paths under /api are never rewritten to the shell.
  - The app uses <base href="/">, so it must be published at the root of its own site (or host).
    To publish under a subfolder instead (e.g. https://serv.homecuties.com/admin), also change the
    base href in src/index.html to that folder.
-->
<configuration>
  <system.web>
  </system.web>

  <system.webServer>
    <!-- Configure default document -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
        <add value="index.csr.html" />
      </files>
    </defaultDocument>

    <!-- MIME types used by Angular build output (harmless today, avoids 404.3 if fonts are added) -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <!-- SPA routing: unknown paths are served the Angular shell, real files/folders are untouched -->
    <rewrite>
      <rules>
        <rule name="Angular Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{DOCUMENT_ROOT}/index.html" matchType="IsFile" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>

        <!-- Fallback for SSR build output, which names the shell index.csr.html -->
        <rule name="Angular Routes (CSR shell)" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{DOCUMENT_ROOT}/index.csr.html" matchType="IsFile" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.csr.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
