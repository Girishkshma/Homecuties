<?xml version="1.0" encoding="utf-8"?>
<!--
  Node.js availability probe for IIS (HttpPlatformHandler).

  Before uploading this folder:
    1. Replace the CHANGE-ME path in `arguments` with the real absolute path of probe.mjs on the
       server, e.g. "D:\vhosts\homecuties.com\httpdocs\node-probe\probe.mjs".
    2. If you do not know where node.exe lives, first try processPath="node.exe" (bare command).
       That works only when the IIS worker process has Node on its PATH; if it fails, try the
       usual absolute locations: C:\Program Files\nodejs\node.exe, C:\nvm4w\nodejs\node.exe,
       or ask the host for the path.

  A JSON reply at /node-probe/ means Node.js is available. Every other outcome is explained in
  README.md (500.19 = handler section locked, 500.50/502 = HttpPlatformHandler missing or the
  process failed to start - check .\logs\node-probe_*.log).

  Delete this folder from the server once the answer is known.
-->
<configuration>
  <system.webServer>
    <handlers>
      <clear />
      <add name="nodeProbe" path="*" verb="*"
           modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>

    <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                  arguments="&quot;D:\CHANGE-ME\node-probe\probe.mjs&quot;"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node-probe"
                  startupTimeLimit="30">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
