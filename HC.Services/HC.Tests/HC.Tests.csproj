<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HC.Business\HC.Business.csproj" />
    <!-- The Twilio SMS adapter, for the rules that decide whether a number can be texted and whether
         the adapter is ready - both are pure decisions that must not need a Twilio account to test. -->
    <ProjectReference Include="..\HC.Adapters\HC.Adapters.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rules of the order lifecycle, the returns flow and the stock pools, pinned where they can be
         run without a database. Every one of them is a rule two screens depend on - the storefront's
         buttons and the server's refusals, or the admin screen and the courier pull - so a test here is
         what keeps them from drifting apart. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <!-- The SMS adapter reads its settings through IConfiguration, so a test builds a section in memory
         rather than standing a configuration file up. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.7" />
    <!-- One test builds a real container, because who registers the sender - the business layer, not the
         host - is what keeps the provider out of HC.Services; the abstraction alone cannot show that. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
