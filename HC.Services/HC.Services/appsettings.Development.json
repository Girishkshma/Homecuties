{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Where the shop's product images live while the shop is being developed (see
  // HC.Business.ProductImageService.ResolveRoot). The storefront runs on its own here - 'ng serve' serves
  // 'HC.Web/src/assets' as '{storefront host}/images/...', which is the folder the storefront's own pages ask
  // for a photograph at - so an upload has to land there or the page it was uploaded for would not show it.
  // A relative root is read from the API's content root, so this is the storefront's asset folder from any
  // working directory. Left out, uploads land in the API's own 'wwwroot/images/products' instead, which is
  // what a shop whose storefront is served by the API host needs and is what the published shop uses.
  "ProductImages": {
    "Root": "..\\..\\HC.Web\\src\\assets\\images\\products"
  }
}
