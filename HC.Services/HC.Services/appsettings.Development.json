{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Where the shop's product images live while the shop is being developed (see
  // HC.Business.ProductImageService.ResolveRoot). The storefront runs on its own here - 'ng serve' serves
  // 'HC.Web/src/assets' as '{storefront host}/images/...', which is the folder the storefront's own pages ask
  // for a photograph at - so an upload has to land there or the page it was uploaded for would not show it.
  // A relative root is read from the API's content root, so this is the storefront's asset folder from any
  // working directory. Left out, uploads land in the API's own 'wwwroot/images/products' instead, which is
  // what a shop whose storefront is served by the API host needs and is what the published shop uses.
  "ProductImages": {
    "Root": "..\\..\\HC.Web\\src\\assets\\images\\products"
  },
  // Text messages are switched OFF while the shop is being developed: a developer's machine must not
  // send a real SMS (or bill the shop for one) every time a booking is tried out. The credentials are
  // still read from 'appsettings.Local.json'/the environment when they are there, so setting this to
  // true is all it takes to try a real send (see HC.Adapters.Messaging.TwilioSmsSender).
  "Twilio": {
    "Enabled": false
  },
  // Portal access: a browser on this machine reaches the API over loopback ('::1'), which is nowhere in the
  // world, so every hit it records from here is unplaced and the Portal Access screen could not be read while
  // the shop is being written. This address is asked about in its place (see HC.Business.Geo.IpGeoLocator) -
  // put your own in, or empty it to place nothing. It is read in Development only, so a deployed shop always
  // places a visitor by the address the request really came from; the hit itself still records '::1'.
  "GeoLookup": {
    "DevelopmentAddress": "49.36.45.12"
  }
}
