<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the web.config the publish generates for IIS.
  Pinning ASPNETCORE_ENVIRONMENT here is what makes the server load 'appsettings.Production.json'
  (the live Razorpay keys) instead of the Development/test values, whatever the machine or app pool
  is set to. stdoutLogEnabled writes the startup log - including the "Razorpay mode: LIVE/TEST"
  line - to .\logs\stdout, so the deployed mode can be verified without a debugger.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\HC.Services.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
